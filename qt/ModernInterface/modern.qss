/* OpenRGB Studio */
QWidget { color: #efeff5; font-size: 13px; }
QMainWindow { background: #202026; }
QMainWindow[backdrop="true"] { background: transparent; }
QWidget#ModernRoot, QWidget#centralWidget { background: transparent; }
QWidget#AppSidebar { background: rgba(26, 26, 32, 215); border-right: 1px solid rgba(255,255,255,12); }
QWidget#AppWorkspace { background: rgba(29, 29, 35, 235); }
QWidget#PageHeading, QWidget#PrimaryNavigation, QWidget#SecondaryNavigation, QWidget#NavigationWorkspace { background: transparent; }
QLabel { background: transparent; border: none; }
QLabel#BrandName { font-size: 23px; font-weight: 600; letter-spacing: -0.4px; }
QLabel#SidebarEyebrow { color: #92929f; font-size: 10px; letter-spacing: 1.2px; }
QLabel#PageTitle { font-size: 29px; font-weight: 600; letter-spacing: -0.5px; }
QLabel#PageDescription { color: #a5a5b3; font-size: 13px; }
QLabel#DeviceCount { color: #dfdfe8; font-size: 12px; }
QLabel#DialogHeading { font-size: 21px; font-weight: 600; }
QLabel[muted="true"] { color: #a5a5b3; }
QFrame#SidebarStatus { background: rgba(255,255,255,5); border: 1px solid rgba(255,255,255,12); border-radius: 10px; }
QListWidget#PrimaryList, QListWidget#SecondaryList { background: transparent; border: none; outline: none; }
QListWidget#PrimaryList::item { padding: 4px 12px; border: 1px solid transparent; border-radius: 7px; }
QListWidget#PrimaryList::item:hover { background: rgba(255,255,255,9); }
QListWidget#PrimaryList::item:selected { background: rgba(255,255,255,17); border-left: 3px solid @ACCENT@; color: #ffffff; }
QListWidget#SecondaryList::item { padding: 8px 12px; background: #282830; border: 1px solid #31313b; border-radius: 8px; }
QListWidget#SecondaryList::item:hover { background: #31313b; border-color: #454550; }
QListWidget#SecondaryList::item:selected { background: @ACCENT_SURFACE@; border-color: @ACCENT@; color: #ffffff; }
QListWidget#SecondaryList::item:disabled { color: #81818d; }
QTabWidget::pane { border: none; background: transparent; padding: 0; }
QTabWidget > QWidget { background: transparent; }
QTabBar::tab { background: #2b2b34; border: 1px solid transparent; border-radius: 6px; padding: 9px 14px; margin: 3px; }
QTabBar::tab:selected { background: @ACCENT_SURFACE@; border-bottom: 2px solid @ACCENT@; }
QTabBar::tab:hover { background: #373740; }
QDialog { background: #24242c; }
QFrame[frameShape="6"], QFrame[frameShape="5"] { border: 1px solid #383842; border-radius: 9px; background: #282830; }
QFrame#ColorFrame, QFrame#LEDFrame, QFrame#DeviceFrame, QFrame#ModeFrame { background: #282830; border: 1px solid #383842; border-radius: 10px; }
QFrame#ProfileCommandBar { background: #282830; border: 1px solid #383842; border-radius: 10px; padding: 10px; }
QGroupBox { background: #282830; border: 1px solid #383842; border-radius: 10px; margin-top: 18px; padding: 16px 12px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 8px; color: #eeeef5; }
QPushButton, QToolButton { background: #35353f; border: 1px solid #454550; border-bottom-color: #292932; border-radius: 6px; padding: 7px 13px; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #41414c; border-color: #5a5a66; }
QPushButton:pressed, QToolButton:pressed { background: #2d2d36; }
QPushButton:focus, QToolButton:focus { border-color: @ACCENT@; }
QPushButton:disabled, QToolButton:disabled { background: #2c2c34; color: #797987; border-color: #373740; }
QPushButton:checked, QToolButton:checked { background: @ACCENT_SURFACE@; border-color: @ACCENT@; }
QPushButton[primary="true"], QToolButton[primary="true"] { background: @ACCENT@; color: #281c27; border-color: @ACCENT@; font-weight: 600; }
QPushButton#AppearanceButton { text-align: left; background: transparent; border-color: transparent; padding-left: 12px; }
QPushButton#AppearanceButton:hover { background: rgba(255,255,255,10); }
QToolButton::menu-button { width: 18px; border: none; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #303039; border: 1px solid #41414c; border-bottom: 1px solid #676775; border-radius: 5px; padding: 7px 10px; min-height: 18px; selection-background-color: @ACCENT@; selection-color: #201722; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-bottom: 2px solid @ACCENT@; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color: #797987; border-color: #373740; background: #292931; }
QComboBox { padding-right: 28px; }
QComboBox::drop-down { width: 24px; border: none; }
QComboBox QAbstractItemView { background: #303039; border: 1px solid #4b4b58; padding: 6px; outline: none; selection-background-color: @ACCENT_SURFACE@; selection-color: white; }
QComboBox QAbstractItemView::item { min-height: 30px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { width: 19px; border: none; background: transparent; }
QCheckBox, QRadioButton { spacing: 9px; background: transparent; padding: 4px 0; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 4px; border: 1px solid #90909e; background: #24242c; }
QCheckBox::indicator:hover { border-color: @ACCENT@; }
QCheckBox::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; image: url(:/modern/check.png); }
QCheckBox::indicator:indeterminate { background: @ACCENT@; image: url(:/modern/minus.png); }
QCheckBox::indicator:disabled { border-color: #555560; background: #393942; }
QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #9696a2; border-radius: 9px; background: #26262e; }
QRadioButton::indicator:checked { background: @ACCENT@; border: 4px solid @ACCENT_SURFACE@; }
QSlider::groove:horizontal { background: #494952; height: 4px; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @ACCENT@; border-radius: 2px; }
QSlider::handle:horizontal { background: @ACCENT@; border: 3px solid #393940; width: 15px; height: 15px; margin: -8px 0; border-radius: 10px; }
QSlider::handle:horizontal:hover { border-color: #6b5067; }
QSlider::groove:vertical { background: #494952; width: 4px; border-radius: 2px; }
QSlider::handle:vertical { background: @ACCENT@; width: 16px; height: 16px; margin: 0 -6px; border-radius: 8px; }
QSlider:disabled::sub-page:horizontal, QSlider:disabled::handle:horizontal { background: #62626c; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #62626e; border-radius: 3px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #8b8b98; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #62626e; border-radius: 3px; min-width: 32px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QMenu { background: #303039; border: 1px solid #50505b; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 8px 24px 8px 12px; border-radius: 4px; }
QMenu::item:selected { background: @ACCENT_SURFACE@; }
QMenu::separator { height: 1px; background: #4b4b56; margin: 5px 8px; }
QToolTip { background: #34343e; color: #f1f1f6; border: 1px solid #565662; padding: 7px; border-radius: 5px; }
QHeaderView::section { background: #303039; color: #bcbcca; padding: 9px; border: none; border-bottom: 1px solid #464652; }
QTableView, QTreeView, QTextEdit, QPlainTextEdit, QListWidget { background: #25252d; alternate-background-color: #2b2b34; border: 1px solid #393944; border-radius: 7px; gridline-color: #393944; selection-background-color: @ACCENT_SURFACE@; selection-color: white; }
QTreeView::item, QTableView::item { padding: 5px; }
QProgressBar { border: none; border-radius: 3px; background: #3b3b46; min-height: 6px; text-align: center; }
QProgressBar::chunk { background: @ACCENT@; border-radius: 3px; }
QSplitter::handle { background: #383842; }
QSplitter::handle:horizontal { width: 1px; }
QStatusBar { background: transparent; color: #aaaab8; }

QLabel#DeviceHeading { font-size: 19px; font-weight: 600; }
QFrame#DeviceControlsCard { background: #282830; border: 1px solid #383842; border-radius: 10px; }
QLabel#RazerBatteryStatus { color: #a5dabb; padding: 10px 12px; background: #27332f; border-radius: 6px; }

QGroupBox QWidget { font-weight: 400; }
QPushButton[text=""], QToolButton[text=""] { padding: 4px; min-width: 18px; min-height: 18px; }

/* Fixed-width plugin icon buttons must retain room for their glyphs. */
QToolButton { padding: 4px; min-height: 18px; }
QToolButton#ButtonSaveProfile { padding: 7px 13px; }
QAbstractSpinBox QLineEdit, QComboBox QLineEdit { padding: 0; border: none; min-height: 0; background: transparent; }
QComboBox::down-arrow { image: url(:/modern/down.png); width: 12px; height: 12px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/modern/up.png); width: 10px; height: 8px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/modern/down.png); width: 10px; height: 8px; }
QSpinBox, QDoubleSpinBox { padding-right: 24px; }
QScrollArea#EffectPageScroll { background: transparent; border: none; }

/* Toggle switches are used for application preferences, not zone selection. */
OpenRGBSettingsPage QCheckBox::indicator, QWidget[modernPlugin="LightSync"] QCheckBox::indicator {
 width: 38px; height: 20px; border-radius: 11px; border: 1px solid #82828e;
 background: #393943; image: url(:/modern/toggle-off.png);
}
OpenRGBSettingsPage QCheckBox::indicator:checked, QWidget[modernPlugin="LightSync"] QCheckBox::indicator:checked {
 background: @ACCENT@; border-color: @ACCENT@; image: url(:/modern/toggle-on.png);
}
QDialog[backdrop="true"] { background: rgba(36,36,44,235); }

QTableView::indicator { width: 16px; height: 16px; border-radius: 4px; border: 1px solid #92929f; background: #27272f; }
QTableView::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; image: url(:/modern/check.png); }
QTableView::indicator:unchecked { image: none; }
QTableWidget { padding: 3px; }
QTabWidget#LightSyncSections::pane { background: transparent; border: none; }

QListWidget#PrimaryList[compact="true"]::item { padding: 4px; }
QScrollArea#WorkspaceScroll { border: none; background: transparent; }
